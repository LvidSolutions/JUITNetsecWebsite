# The server rejects submissions unless this is exactly "true".
# Keep it false until Preview has passed a real end-to-end email test.
CONTACT_FORM_ENABLED=false

# Resend (server-only)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=JUIT NetSec Website <website@your-verified-sending-domain.example>
CONTACT_TO_EMAIL=contact@juit.se

# Cloudflare Turnstile. The VITE value is public; the secret is server-only.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=

# Upstash Redis (server-only distributed rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_HASH_SECRET=
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_EMAIL_MAX=2
CONTACT_RATE_LIMIT_WINDOW_SECONDS=900
