# Public Vite values. Everything prefixed with VITE_ is visible in the browser.
VITE_CONTACT_FORM_ENABLED=false
VITE_CONTACT_API_URL=/api/contact
VITE_TURNSTILE_SITE_KEY=PUBLIC_TURNSTILE_SITE_KEY

# Server-only Vercel Function values. Never prefix these with VITE_.
CONTACT_FORM_ENABLED=false
RESEND_API_KEY=EMAIL_API_KEY
CONTACT_FROM_EMAIL=JUIT NetSec Website <website@notify.example.se>
CONTACT_TO_EMAIL=CONTACT_INBOX@example.se
TURNSTILE_SECRET_KEY=TURNSTILE_SECRET_KEY
TURNSTILE_ALLOWED_HOSTNAMES=example.se,www.example.se
UPSTASH_REDIS_REST_URL=REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=REDIS_REST_TOKEN
RATE_LIMIT_HASH_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=900
